{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Visual Direction",
  "type": "object",
  "required": ["version", "project", "visual_concept", "reference_principles", "typography_direction", "image_art_direction", "scale_relationships", "whitespace_strategy", "visual_rhythm", "section_transitions", "signature_visual_moves", "quality_bar", "avoid"],
  "properties": {
    "version": {"type": "string"},
    "project": {"type": "string", "minLength": 1},
    "visual_concept": {"type": "string", "minLength": 20},
    "reference_principles": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object", "required": ["reference", "what_works", "principle", "adaptation", "do_not_copy"],
        "properties": {
          "reference": {"type": "string", "minLength": 1},
          "what_works": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "principle": {"type": "string", "minLength": 10},
          "adaptation": {"type": "string", "minLength": 10},
          "do_not_copy": {"type": "string", "minLength": 10}
        }
      }
    },
    "typography_direction": {"type": "object", "required": ["hierarchy", "display_role", "body_role", "contrast"], "properties": {"hierarchy": {"type": "string"}, "display_role": {"type": "string"}, "body_role": {"type": "string"}, "contrast": {"type": "string"}}},
    "image_art_direction": {"type": "object", "required": ["hero", "supporting", "gallery"], "properties": {"hero": {"type": "string"}, "supporting": {"type": "string"}, "gallery": {"type": "string"}}},
    "scale_relationships": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "whitespace_strategy": {"type": "string", "minLength": 20},
    "visual_rhythm": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "section_transitions": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "signature_visual_moves": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string"}},
    "quality_bar": {"type": "array", "minItems": 5, "items": {"type": "string"}},
    "avoid": {"type": "array", "minItems": 5, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
