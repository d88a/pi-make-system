        "catalog-header",
        "category-filter",
        "product-grid",
        "lead-cta"
      ],
      "dynamic_data": [
        "wc_product_loop (all 22 products)",
        "wc_category_filter",
        "wc_breadcrumbs",
        "catalog_title (customizer)",
        "catalog_subtitle (customizer)",
        "catalog_quick_stats (customizer)"
      ],
      "hardcoded_content": [
        "catalog_title: 'Каталог продукции'",
        "catalog_subtitle: '22 продукта из кевларбетона...'",
        "quick_stats: 22 продукта, 5 категорий, от 850 руб",
        "filter_pills: Все, Тротуарная плитка, Брусчатка, Бордюры, Памятники"
