  "woocommerce_overrides_needed": [
    "single-product.php",
    "archive-product.php",
    "content-product.php",
    "single-product/price.php",
    "single-product/product-image.php",
    "single-product/product-attributes.php",
    "loop/price.php",
    "loop/sale-flash.php",
    "global/breadcrumb.php"
  ],
  "woocommerce_catalog_mode": {
    "enabled": true,
    "remove_add_to_cart": true,
    "replace_with": "Рассчитать стоимость → /calculator",
    "hooks": [
      "remove_action('woocommerce_single_product_summary', 'woocommerce_template_single_add_to_cart', 30)",
      "remove_action('woocommerce_after_shop_loop_item', 'woocommerce_template_loop_add_to_cart', 10)"
    ],
    "enquiry_button_callback": "stroymaks2026_enquiry_button"
  },
  "static_assets": {
    "images": [
      "assets/images/ (from WP uploads, not local)"
    ],
    "css": [
      "tailwind/input.css → assets/css/tailwind.css"
    ],
    "js": [
      "assets/js/main.js"
    ]
  },
