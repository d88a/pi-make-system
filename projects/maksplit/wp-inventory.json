  "shared_components": {
    "nav.html": {
      "wp_dest": "header.php",
      "type": "global",
      "has_mobile_menu": true,
      "has_cta_button": true,
      "cta_text": "Рассчитать стоимость",
      "cta_link": "/calculator",
      "phone": "+7 (35147) 1-23-45",
      "menu_items": ["Главная", "Каталог", "О компании", "Доставка", "Контакты"]
    },
    "footer.html": {
      "wp_dest": "footer.php",
      "type": "global",
      "columns": "3 (brand + catalog + contacts)",
      "has_steel_divider": true,
      "copyright": "© 2015–2025 СтройМакс",
      "email": "info@maksplit.ru"
    },
    "hero.html": {
      "wp_dest": "template-parts/hero.php",
      "type": "reusable",
      "used_by": ["home"],
      "has_texture_overlay": true,
      "has_stats_bar": true,
      "has_cta_buttons": true
    },
    "product-card.html": {
      "wp_dest": "template-parts/product-card.php",
      "type": "reusable",
      "used_by": ["home", "catalog", "product"],
      "photo_policy": "object-contain",
      "has_category_badge": true,
      "has_price": true,
      "cta_button": "Подробнее (→ product page, NOT add to cart)"
    },
    "category-grid.html": {
      "wp_dest": "template-parts/category-grid.php",
      "type": "reusable",
      "used_by": ["home", "catalog"],
      "categories": [
        {"name": "Брусчатка", "slug": "bruschatka", "count": 9},
        {"name": "Тротуарная плитка", "slug": "plitka", "count": 7},
        {"name": "Бордюры, водостоки", "slug": "bordury", "count": 3},
        {"name": "Памятники из бетона", "slug": "pamyatniki", "count": 3}
      ]
    },
    "lead-form.html": {
      "wp_dest": "template-parts/lead-form.php",
      "type": "reusable",
      "used_by": ["home", "catalog", "product", "about", "contacts", "delivery", "calculator"],
      "fields": ["name", "phone", "volume", "comment"],
      "action": "cf7",
      "cta_text": "Получить расчёт",
      "bg": "accent (Steel Blue #3B5F8A)"
    },
    "features.html": {
      "wp_dest": "template-parts/features.php",
      "type": "reusable",
      "used_by": ["home", "product"],
      "variant": "numbered + icon cards",
      "count": 4
    },
    "product-detail.html": {
      "wp_dest": "template-parts/product-detail.php",
      "type": "reusable",
      "used_by": ["product"],
      "includes": ["gallery", "info", "color_picker", "characteristics", "cta"]
    }
  },
