        "features",
        "category-grid",
        "popular-products",
        "lead-cta"
      ],
      "dynamic_data": [
        "products_loop (WC)",
        "categories_list (WC)",
        "hero_eyebrow (customizer)",
        "hero_title (customizer)",
        "hero_subtitle (customizer)",
        "hero_stats (customizer)",
        "features_list (customizer/ACF)"
