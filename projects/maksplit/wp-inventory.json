      "components_used": [
        "nav",
        "footer",
        "product-card",
        "lead-form"
      ]
    },
    "product.html": {
      "type": "woocommerce_single",
      "wp_template": "single-product.php (WC override)",
      "sections": [
        "breadcrumb",
        "product-gallery",
        "product-info",
        "color-picker",
        "characteristics",
        "product-description",
        "features",
        "related-products",
        "lead-cta"
      ],
      "dynamic_data": [
        "wc_gallery + thumbnails",
        "wc_title",
        "wc_price",
        "wc_category_badge",
        "wc_short_description",
        "wc_attributes (characteristics table)",
        "wc_related_products",
        "wc_breadcrumbs"
