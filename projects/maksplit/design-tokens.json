    "text-primary": "#1C1917",
    "text-secondary": "#57534E",
    "text-muted": "#57534E",
    "text-inverse": "#F5F5F4",
    "success": "#059669",
    "danger": "#DC2626",
    "warning": "#D97706",
    "border": "#D6D3D1",
    "border-hover": "#A8A29E",
    "border-subtle": "#E7E5E4",
    "primary": "#3B5F8A",
    "primary-hover": "#2E4A6E",
    "primary-active": "#1E3550",
    "primary-glow": "rgba(59,95,138,0.35)",
    "primary-subtle": "rgba(59,95,138,0.08)",
    "border-primary-hover": "rgba(59,95,138,0.5)"
  },
  "gradients": {
    "primary": "linear-gradient(135deg, #3B5F8A, #2E4A6E)",
