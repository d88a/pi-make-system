[
  {
    "id": "hero_section",
    "elType": "section",
    "settings": {
      "layout": "full_width",
      "stretch_section": "section-stretched",
      "background_background": "classic",
      "background_color": "#2F4A33",
      "padding": {"unit": "px", "top": "200", "bottom": "200"},
      "content_width": {"unit": "px", "size": 1200}
    },
    "elements": [
      {
        "id": "hero_col",
        "elType": "column",
        "settings": {"_column_size": 100, "content_position": "center"},
        "elements": [
          {
            "id": "hero_h1",
            "elType": "widget",
            "widgetType": "heading",
            "settings": {
              "title": "Проект возрождения усадьбы «Барышня-крестьянка»",
              "size": "xxl",
              "align": "center",
              "title_color": "#F5EFE3",
              "typography_typography": "custom",
              "typography_font_family": "Playfair Display",
              "typography_font_weight": "700",
              "typography_font_size": {"unit": "px", "size": 64}
            }
          },
          {
            "id": "hero_subtitle",
            "elType": "widget",
            "widgetType": "text-editor",
            "settings": {
              "editor": "<p style=\"text-align:center;color:#F5EFE3;font-size:24px;font-style:italic;\">Возвращение жизни в родовое гнездо на тамбовской земле.</p>",
              "align": "center"
            }
          },
          {
            "id": "hero_text",
            "elType": "widget",
            "widgetType": "text-editor",
            "settings": {
              "editor": "<p style=\"text-align:center;max-width:700px;margin:20px auto 0;color:#F5EFE3;\">Ищем партнёров, разделяющих наши ценности, для совместного создания устойчивого семейного поместья и культурно-исторического центра.</p>",
              "align": "center"
            }
          },
          {
            "id": "hero_btn",
            "elType": "widget",
            "widgetType": "button",
            "settings": {
              "text": "Узнать подробнее",
              "link": {"url": "#contacts"},
              "align": "center",
              "background_color": "#B8963E",
              "button_text_color": "#2B2620",
              "typography_font_weight": "600",
              "button_padding": {"unit": "px", "top": "14", "right": "28", "bottom": "14", "left": "28"}
            }
          }
        ]
      }
    ]
  },
  {
    "id": "about_section",
    "elType": "section",
    "settings": {
      "layout": "boxed",
      "background_background": "classic",
      "background_color": "#FAF6EC",
      "padding": {"unit": "px", "top": "100", "bottom": "100"},
      "content_width": {"unit": "px", "size": 900}
    },
    "elements": [
      {
        "id": "about_col",
        "elType": "column",
        "settings": {"_column_size": 100},
        "elements": [
          {
            "id": "about_h2",
            "elType": "widget",
            "widgetType": "heading",
            "settings": {
              "title": "Дорогие друзья!",
              "size": "xl",
              "align": "center",
              "title_color": "#2F4A33",
              "typography_typography": "custom",
              "typography_font_family": "Playfair Display",
              "typography_font_weight": "700",
              "typography_font_size": {"unit": "px", "size": 42}
            }
          },
          {
            "id": "about_text",
            "elType": "widget",
            "widgetType": "text-editor",
            "settings": {
              "editor": "<p style=\"text-align:center;line-height:1.7;color:#2B2620;\">Мы рады приветствовать вас на официальной странице проекта возрождения усадьбы «Барышня-крестьянка». Проект реализуется силами Благотворительного фонда содействия учебным заведениям и патриотического воспитания подрастающего поколения, при поддержке Администрации Тамбовской области, Совета Федерации ФС РФ и ветеранов Вооружённых Сил России.</p>",
              "align": "center"
            }
          }
        ]
      }
    ]
  }
]