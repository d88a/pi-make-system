          "id": "aw3",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<div style=\"display:flex;flex-wrap:wrap;justify-content:center;gap:20px;margin-top:60px;\"><div style=\"background:#fff;padding:20px 30px;text-align:center;border:1px solid #E3D9C6;min-width:150px;\"><span style=\"font-size:12px;text-transform:uppercase;letter-spacing:1px;color:#6B6156;\">Минкультуры РФ</span></div><div style=\"background:#fff;padding:20px 30px;text-align:center;border:1px solid #E3D9C6;min-width:150px;\"><span style=\"font-size:12px;text-transform:uppercase;letter-spacing:1px;color:#6B6156;\">Минсельхоз РФ</span></div><div style=\"background:#fff;padding:20px 30px;text-align:center;border:1px solid #E3D9C6;min-width:150px;\"><span style=\"font-size:12px;text-transform:uppercase;letter-spacing:1px;color:#6B6156;\">РГО</span></div><div style=\"background:#fff;padding:20px 30px;text-align:center;border:1px solid #E3D9C6;min-width:150px;\"><span style=\"font-size:12px;text-transform:uppercase;letter-spacing:1px;color:#6B6156;\">Адм. Тамбовской обл.</span></div><div style=\"background:#fff;padding:20px 30px;text-align:center;border:1px solid #E3D9C6;min-width:150px;\"><span style=\"font-size:12px;text-transform:uppercase;letter-spacing:1px;color:#6B6156;\">Совет Федерации ФС РФ</span></div></div>"
