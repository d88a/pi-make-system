            "html": "<div style=\"display:grid;grid-template-columns:repeat(4,1fr);gap:20px;max-width:900px;margin:60px auto 0;\"><div style=\"border:1px solid rgba(184,150,62,0.3);padding:20px;text-align:center;\"><p style=\"font-family:'Playfair Display',serif;font-size:36px;font-weight:700;color:#B8963E;\">1702</p><p style=\"color:#F5EFE3;font-size:14px;\">Год основания</p></div><div style=\"border:1px solid rgba(184,150,62,0.3);padding:20px;text-align:center;\"><p style=\"font-family:'Playfair Display',serif;font-size:36px;font-weight:700;color:#B8963E;\">20 га</p><p style=\"color:#F5EFE3;font-size:14px;\">Исторический парк</p></div><div style=\"border:1px solid rgba(184,150,62,0.3);padding:20px;text-align:center;\"><p style=\"font-family:'Playfair Display',serif;font-size:36px;font-weight:700;color:#B8963E;\">2027</p><p style=\"color:#F5EFE3;font-size:14px;\">Старт работ</p></div><div style=\"border:1px solid rgba(184,150,62,0.3);padding:20px;text-align:center;\"><p style=\"font-family:'Playfair Display',serif;font-size:36px;font-weight:700;color:#B8963E;\">300+</p><p style=\"color:#F5EFE3;font-size:14px;\">Лет истории</p></div></div>"
