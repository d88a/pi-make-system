            "typography_font_weight": "700"
          }
        },
        {
          "id": "hiw2",
          "elType": "widget",
          "widgetType": "text-editor",
          "settings": {
            "editor": "<p style=\"line-height:1.7;color:#2B2620;max-width:800px;margin:0 auto;\">Название проекта не случайно. Именно здесь, в старинном селе Гагарино Тамбовской области (основанном в мае 1702 года князем Матвеем Гагариным), жила Дарья Пашкова — дочь бригадного генерала Алексея Александровича Пашкова, ставшая впоследствии бабушкой легендарного генерала М.Д. Скобелева.</p><p style=\"line-height:1.7;color:#2B2620;max-width:800px;margin:20px auto 0;\">Это имение хранит память о великих людях: здесь работал художник Валентин Серов, бывал великий князь Н.Н. Романов, а ученица Полины Виардо писала здесь музыку на стихи Пушкина.</p>"
          }
        }
      ]
    }]
  },
